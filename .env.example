APP_NAME="First to Act Poker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────
# Two shipped features depend on this and fail SILENTLY without it: email
# verification (which gates the dashboard) and the admin invite link (which is
# the only way a player created by an administrator can set a password).
# Nothing errors when mail is misconfigured -- it simply never arrives.
#
# Run `php artisan mail:check` after setting these. It reports what is
# resolved, refuses to pass on the placeholders below, and `--send=you@example.com`
# will prove delivery end to end.
#
# "log" writes mail to storage/logs/laravel.log and delivers nothing. It is
# fine for development and wrong for anything a real player will use.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# MUST be an address on a domain you control, with SPF/DKIM configured for
# whichever provider sends. Mail sent from an address the domain does not own
# is accepted by the sender and dropped or spam-filed by the recipient, which
# looks exactly like mail that was never sent.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Where contact-form submissions are delivered, and the address the contact
# page displays. One value for both, so the page cannot advertise an address
# the form does not use.
LEAGUE_CONTACT_EMAIL="hello@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
